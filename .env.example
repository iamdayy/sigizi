# App Environment
APP_ENV=development
APP_PORT=8080
TZ=Asia/Jakarta

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
DB_NAME=mbg_sppg_db
DB_SSLMODE=disable

# JWT Authentication
JWT_ACCESS_SECRET=REPLACE_ME_WITH_MINIMUM_32_CHARS_SECRET_KEY
JWT_REFRESH_SECRET=REPLACE_ME_WITH_MINIMUM_32_CHARS_SECRET_KEY
JWT_ACCESS_DURATION_MINUTES=15
JWT_REFRESH_DURATION_DAYS=7

# Webhooks
BANK_WEBHOOK_SECRET=your_bank_webhook_secret_key

# Cloudflare R2 / AWS S3 Storage
STORAGE_DRIVER=local # "s3" or "local"
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_BUCKET_NAME=mbg-bast-documents
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://pub-yourdomain.r2.dev
LOCAL_STORAGE_PATH=./uploads

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
